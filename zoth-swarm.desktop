[Desktop Entry]
Version=1.0
Type=Application
Name=Zoth Swarm Multiplexer
GenericName=Multi-Agent Terminal Multiplexer
Comment=21-Agent Swarm Topology, SSE Telemetry, Harness Hot-Swapping & CLI Console
Exec=/usr/local/bin/zoth-swarm desktop
Icon=zoth-swarm
Terminal=false
Categories=Development;System;Network;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open Swarm CLI
Exec=x-terminal-emulator -e "/usr/local/bin/zoth-swarm --help"

[Desktop Action Web]
Name=Open Web UI (Port 8141)
Exec=/usr/local/bin/zoth-swarm web
